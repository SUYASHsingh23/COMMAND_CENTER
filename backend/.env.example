# =============================================================================
# InsureAI Command Center 3.0 — Backend Environment Configuration
# =============================================================================
# Copy this file to .env in the backend/ directory:
#   cp .env.example .env     (Linux/macOS)
#   copy .env.example .env   (Windows)
# =============================================================================

# ── PostgreSQL Database Connection (Asyncpg Driver) ──────────────────────────
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/command_center

# ── Redis Cache & Pub/Sub ───────────────────────────────────────────────────
# Used for real-time WebSocket state distribution and RAG query semantic caching
REDIS_URL=redis://localhost:6379/0

# ── Speech-to-Text & Text-to-Speech API Keys ─────────────────────────────────
# Sarvam AI (https://www.sarvam.ai) for Indian-accent multilingual STT/TTS
SARVAM_API_KEY=your_sarvam_api_key_here

# ── LLM Inference Provider ──────────────────────────────────────────────────
# Groq (https://console.groq.com) for ultra-fast Llama-3-70b / 8b agent reasoning
GROQ_API_KEY=your_groq_api_key_here

# ── Authentication & Security ────────────────────────────────────────────────
# Secret key for JWT token encoding/decoding. Change to a random string in production!
SECRET_KEY=command_center_secret_key_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Network & CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origin URLs
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Logging ──────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Hybrid RAG Knowledge Base (Optional Overrides) ───────────────────────────
# RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
# RAG_TOP_K=5
# RAG_MIN_SCORE=0.25
# RAG_ENABLE_REDIS=true
